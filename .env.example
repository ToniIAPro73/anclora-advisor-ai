AI_RUNTIME_PROFILE=local

NEON_DATA_API_URL=
# Optional direct Neon SQL connection for applying versioned migrations.
DATABASE_URL=
NEON_DATA_API_JWT_AUDIENCE=authenticated
NEON_SERVICE_JWT_PRIVATE_KEY=
NEON_SERVICE_JWT_KID=anclora-advisor-neon-service-v1
NEON_SERVICE_JWT_ISSUER=anclora-advisor-ai
NEON_SERVICE_JWT_TTL_SECONDS=300
# Anclora Identity OIDC is the only application authentication provider.
ANCLORA_IDENTITY_ISSUER_URL=https://anclora-identity.anclora.com
ANCLORA_IDENTITY_CLIENT_ID=anclora-advisor-ai
ANCLORA_IDENTITY_CLIENT_SECRET=
ANCLORA_IDENTITY_REDIRECT_URI=http://localhost:3001/api/auth/anclora-identity/callback
ANCLORA_IDENTITY_SESSION_SECRET=
# Operator-only and used only by the explicit local role migration command.
ANCLORA_IDENTITY_ROLE_ADMIN_TOKEN=
# Vercel Blob is the canonical private object store.
ADVISOR_BLOB_READ_WRITE_TOKEN=

# Local profile: AI_RUNTIME_PROFILE=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PROFILE_NAME=default_ollama
OLLAMA_MODEL_PRIMARY=qwen2.5:14b
OLLAMA_MODEL_FALLBACK=llama3.1:8b
OLLAMA_MODEL_FAST=llama3.2:latest
OLLAMA_MODEL_NO_EVIDENCE=gemma3:1b
OLLAMA_EMBED_MODEL=all-minilm
OLLAMA_MODEL_GUARD=llama3.2:latest
OLLAMA_BASE_URL_ALT=
OLLAMA_PROFILE_NAME_ALT=
OLLAMA_MODEL_PRIMARY_ALT=
OLLAMA_MODEL_FAST_ALT=
OLLAMA_EMBED_MODEL_ALT=
HW_BENCHMARK_MODELS=
HW_BENCHMARK_MODELS_ALT=
ORCHESTRATOR_LOCAL_NO_EVIDENCE=true

# Contract compliance validator: uses the configured AI runtime.
# With AI_RUNTIME_PROFILE=local this runs through Ollama, not a paid API.
ADVISOR_CONTRACT_VALIDATOR_MODEL=qwen2.5:14b
ADVISOR_CONTRACT_VALIDATOR_MAX_TOKENS=1500
ADVISOR_CONTRACT_VALIDATOR_TEMPERATURE=0

# Cloudflare profile: AI_RUNTIME_PROFILE=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=
CLOUDFLARE_MODEL_PRIMARY=@cf/openai/gpt-oss-20b
CLOUDFLARE_MODEL_FALLBACK=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_FAST=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_NO_EVIDENCE=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_GUARD=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-small-en-v1.5

# Hybrid free profile: AI_RUNTIME_PROFILE=groq-cloudflare
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_PRIMARY=openai/gpt-oss-20b
GROQ_MODEL_FALLBACK=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_NO_EVIDENCE=llama-3.1-8b-instant
GROQ_MODEL_GUARD=llama-3.1-8b-instant

# Must match the indexed corpus dimension unless you re-ingest all embeddings.
EMBEDDING_EXPECTED_DIMENSION=384

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Anclora Advisor AI
APP_JOBS_CRON_SECRET=
CRON_SECRET=
ADVISOR_LABOR_EVIDENCE_BUCKET=labor-evidence
ADVISOR_INVOICE_IMPORTS_BUCKET=invoice-imports
INVOICE_IMPORT_VLM_ENABLED=false
ZAI_API_KEY=
ZAI_VISION_MODEL=glm-4.5v
VERIFACTU_ENDPOINT_URL=
VERIFACTU_API_TOKEN=
VERIFACTU_SYSTEM_ID=ANCLORA-ADVISOR-AI


# ── Legal Document Validation Engine ──────────────────────────────────────────
ADVISOR_INTERNAL_API_KEY=
ADVISOR_LEGAL_VALIDATION_MODEL=
ADVISOR_LEGAL_VALIDATION_MAX_TOKENS=
ADVISOR_LEGAL_VALIDATION_TEMPERATURE=
ADVISOR_LEGAL_VALIDATION_TIMEOUT_MS=
ADVISOR_LEGAL_VALIDATION_PROMPT_VERSION=
ADVISOR_LEGAL_VALIDATION_ENGINE_VERSION=
ADVISOR_LEGAL_VALIDATION_RATE_LIMIT=
# Model used for legal document analysis (falls back to ADVISOR_CONTRACT_VALIDATOR_MODEL)
ADVISOR_LEGAL_DOCUMENT_VALIDATOR_MODEL=
# Max tokens for legal document LLM response (default: 1500)
ADVISOR_LEGAL_DOCUMENT_VALIDATOR_MAX_TOKENS=1500
# Temperature for legal document LLM (default: 0 — deterministic)
ADVISOR_LEGAL_DOCUMENT_VALIDATOR_TEMPERATURE=0

# Social OAuth Authentication (Google & GitHub)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=
